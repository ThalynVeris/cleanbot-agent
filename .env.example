# Model provider
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen3-max
EMBEDDING_MODEL_NAME=text-embedding-v4
RERANK_MODEL_NAME=qwen3-rerank
ENABLE_RERANK=true
RERANK_POLICY=always
# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./.runtime/cleanbot.db
VECTOR_DIR=./.runtime/chroma
COLLECTION_NAME=cleanbot_knowledge_v2
ADMIN_TOKEN=change-me-before-deployment
API_BASE_URL=http://localhost:8000
# Native development leaves this empty and uses in-process MCP.
# Docker Compose will use http://device-mcp:8001/mcp.
DEVICE_MCP_URL=
DEVICE_MCP_TIMEOUT_SECONDS=5
DEVICE_CHECKPOINT_PATH=./.runtime/device-checkpoints.sqlite
# Retrieval and model limits
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_N=5
ANSWER_TOP_N=4
MIN_RETRIEVAL_SCORE=0.10
MODEL_TIMEOUT_SECONDS=45
WEATHER_TIMEOUT_SECONDS=6
MAX_HISTORY_MESSAGES=12
